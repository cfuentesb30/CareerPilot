# NOTE: .env files are intentionally tracked for deployment
# Emergent deployment system auto-updates these files during deployment

# Environment files (commented out for deployment)
# .env
# .env.local
# .env.development.local
# .env.test.local
# .env.production.local
# *.env

# Environment files in subdirectories (commented out for deployment)
# backend/.env*
# frontend/.env*

# Dependencies
node_modules/
*/node_modules/
__pycache__/
*/__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Build outputs
build/
dist/
*.egg-info/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Coverage reports
coverage/
.nyc_output
*.lcov

# Temporary files
tmp/
temp/
*.tmp

# Database
*.db
*.sqlite
*.sqlite3

# Backup files
*.bak
*.backup

# Package manager locks (optional - uncomment if needed)
# package-lock.json
# yarn.lock

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Optional npm cache directory
.npm

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity
